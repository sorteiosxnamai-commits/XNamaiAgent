ENVIRONMENT=production
APP_NAME=NewStoreAgent
DRY_RUN=true

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Role models (empty → OPENAI_MODEL). Main = understand + grounded reply; fast = simple structured.
OPENAI_MAIN_MODEL=gpt-4.1-mini
OPENAI_FAST_MODEL=gpt-4.1-nano
# chat_completions | responses | shadow | canary
# Primary path is Responses; Chat Completions is emergency fallback only.
# Progressive canary: OPENAI_API_MODE=canary + OPENAI_RESPONSES_TRAFFIC_PERCENT=0.05…1.0
OPENAI_API_MODE=responses
OPENAI_CHAT_COMPLETIONS_PRIMARY_ALLOWED=false
OPENAI_STORE_RESPONSES=false
# Keep false — commerce state lives in app DB, not OpenAI previous_response_id.
OPENAI_USE_PREVIOUS_RESPONSE_ID=false
OPENAI_USE_CONVERSATIONS_API=false
OPENAI_RESPONSES_STRUCTURED_ENABLED=true
OPENAI_RESPONSES_TOOL_LOOP_ENABLED=true
OPENAI_SHADOW_SAMPLE_RATE=0.10
# Sticky canary share on Responses (0.0–1.0). Ignored when MODE=responses.
OPENAI_RESPONSES_TRAFFIC_PERCENT=1.0
OPENAI_RESPONSES_FALLBACK_TO_CHAT=true
OPENAI_CANARY_STICKY_ROUTING=true
# Etapa 12 — progressive canary (single knob). full | canary_5|25|50|100 | emergency
# shadow | canary_5 | canary_25 | canary_50 | canary_100 | full | emergency
AGENT_ROLLOUT_PROFILE=full
# Instant kill switch (forces emergency profile regardless of PROFILE).
AGENT_EMERGENCY_ROLLBACK=false
AGENT_ROLLOUT_ALERT_ENABLED=true
AGENT_ROLLOUT_ALERT_WINDOW=40
AGENT_ROLLOUT_ALERT_MIN_SAMPLES=20
AGENT_ROLLOUT_FALLBACK_ALERT_RATE=0.25
AGENT_ROLLOUT_FACTUAL_ALERT_RATE=0.10
AGENT_ROLLOUT_HANDOFF_ALERT_RATE=0.40
# Responses controls (applied only when the selected model supports them).
OPENAI_REASONING_EFFORT=medium
OPENAI_TEXT_VERBOSITY=medium
OPENAI_MAX_OUTPUT_TOKENS=
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2
# Phase 5: DB persona (tone/identity). Missing/failed load → in-code operational fallback.
AGENT_DB_PERSONA_ENABLED=true
AGENT_PERSONA_TENANT_ID=newstore
AGENT_PERSONA_KEY=newstore_commercial
AGENT_MAX_RECENT_TURNS=8
AGENT_MAX_ACTIVE_CONTACT_MEMORIES=20
AGENT_MAX_CONTACT_MEMORY_CHARS=3000
AGENT_MAX_INSTRUCTION_EXTENSIONS=20
AGENT_MAX_INSTRUCTION_EXTENSION_CHARS=4000
AGENT_MAX_CONVERSATION_SUMMARY_CHARS=2500
# Phase 7: proposals audit + contact memory inject; auto-apply only with allowlist
AGENT_MEMORY_PROPOSALS_ENABLED=true
AGENT_MEMORY_AUTO_APPLY_ENABLED=false
# Comma-separated sender_key list. Empty=nobody. *=all
AGENT_MEMORY_AUTO_APPLY_SENDER_ALLOWLIST=
AGENT_MEMORY_AUTO_APPLY_MIN_CONFIDENCE=0.85
AGENT_MEMORY_AUTO_APPLY_MIN_IMPORTANCE=0.70
AGENT_CONTACT_MEMORY_IN_PROMPT_ENABLED=true
AGENT_INSTRUCTION_EXTENSION_PROPOSALS_ENABLED=false
# Etapa 8: incremental summary write + optional prompt inject (both off until soak).
AGENT_CONVERSATION_SUMMARY_ENABLED=false
AGENT_CONVERSATION_SUMMARY_IN_PROMPT_ENABLED=false
AGENT_CONVERSATION_SUMMARY_MODE=off
# Etapa 9: attendance learning — insights/pending only; never auto-activate.
AGENT_LEARNING_AUTO_PROMOTE=false
AGENT_LEARNING_AUTO_ACTIVATE=false
AGENT_PROMPT_COMPILATION_AUDIT_ENABLED=true
AGENT_DEBUG_STORE_COMPILED_PROMPT=false
# Rollback only: re-embeds fallback contract (duplicates prompt). Keep false.
AGENT_LEGACY_PROMPT_COMPAT_ENABLED=false
AGENT_RUNTIME_ENABLED=true
# Phase 8: enforce max OpenAI calls/turn; exceeded → deterministic fallback/handoff.
AGENT_LLM_BUDGET_ENABLED=true
# Etapa 6: normal turns ≤ interpret + respond (+ rare gated critique).
AGENT_MAX_LLM_CALLS_PER_TURN=2
# Optional bump for explicitly complex turns (orders/payment recovery).
AGENT_MAX_LLM_CALLS_PER_TURN_COMPLEX=4
# Etapa 3: interpret via TurnUnderstanding → SalesInterpretation adapter.
AGENT_TURN_UNDERSTANDING_ENABLED=true
# off | shadow | enforce
AGENT_POLICY_MODE=shadow
# Recommended: enforce. Shadow only for temporary soak.
AGENT_FACTUAL_VALIDATION_MODE=enforce
AGENT_TRUSTED_FACT_DOMAINS=sorteionewstore.com.br,newstoresorteios.com.br
AGENT_CONVERSATION_LOCK_ENABLED=true
AGENT_CONVERSATION_LOCK_TIMEOUT_SECONDS=15
# Etapa 7: thin | full | shadow — thin = presenter mínimo (canal/URL/blocks).
AGENT_PRESENTER_MODE=thin
# off | shadow | enforce — default off; when enabled, only risk/sample fires LLM.
AGENT_QUALITY_JUDGE_MODE=off
AGENT_QUALITY_JUDGE_RISK_THRESHOLD=70
AGENT_QUALITY_JUDGE_SAMPLE_RATE=0
# Dual-agent critique: shadow + risk gate (LLM only on risk/sample/deterministic fail).
AGENT_CRITIQUE_MODE=shadow
AGENT_CRITIQUE_MAX_RETRIES=1
AGENT_CRITIQUE_LLM_ON_RISK_ONLY=true
AGENT_CRITIQUE_SHADOW_SAMPLE_RATE=0
# Model window sent to OpenAI. Operational recovery still uses HARD_CAP from DB.
AGENT_HISTORY_LIMIT=12
AGENT_HISTORY_HARD_CAP=80
AGENT_SEND_IDEMPOTENCY_ENABLED=true
# Phase 13: short TTL product/stock cache (stock never served stale as absolute fact)
AGENT_PRODUCT_CACHE_ENABLED=true
AGENT_PRODUCT_CACHE_TTL_SECONDS=180
AGENT_PRICE_CACHE_TTL_SECONDS=45
AGENT_STOCK_CACHE_TTL_SECONDS=20
AGENT_SEARCH_CACHE_TTL_SECONDS=45
# Etapa 4: hybrid pool / LLM rerank (5–20) / live revalidate top-N only
AGENT_CANDIDATE_POOL_LIMIT=20
AGENT_RERANK_SELECTION_LIMIT=15
AGENT_REVALIDATE_TOP_N=3
AGENT_CATALOG_INDEX_WRITE_ENABLED=true
AGENT_CATALOG_INDEX_READ_ENABLED=true
AGENT_CATALOG_INDEX_FALLBACK_TO_TRAY=true
AGENT_CATALOG_INDEX_MAX_AGE_SECONDS=86400
AGENT_CATALOG_INDEX_CANDIDATE_LIMIT=30
AGENT_IMAGE_CACHE_TTL_SECONDS=300
# Phase 14: salt for conversation_key_hash in turn.quality events
AGENT_OBS_HASH_SECRET=
# Etapa 10: full/HTTP obs opt-in only (default off — Sem PII em defaults).
AGENT_FULL_OBS_LOGS=false
AGENT_HTTP_OBS_LOGS=false
# Busca por foto: Vision extrai marca/modelo/ref e pesquisa no catálogo
AGENT_IMAGE_SEARCH_ENABLED=true
# Opcional; vazio usa OPENAI_MODEL (precisa ser modelo com vision)
AGENT_IMAGE_SEARCH_MODEL=
AGENT_IMAGE_SEARCH_MIN_CONFIDENCE=0.55
AGENT_IMAGE_DOWNLOAD_MAX_BYTES=8000000
# Fallback visual (caption+embedding / pgvector) quando Vision ou busca textual falha
AGENT_VISUAL_SEARCH_ENABLED=true
AGENT_PRODUCT_IMAGE_INDEX_ENABLED=true
AGENT_VISUAL_EMBEDDING_MODEL=text-embedding-3-small
AGENT_VISUAL_TOP_K=3
AGENT_VISUAL_MAX_DISTANCE=0.45
AGENT_PRODUCT_IMAGE_INDEX_BATCH_SIZE=40
CHECKOUT_CEP_LOOKUP_ENABLED=true
CHECKOUT_CEP_LOOKUP_URL=https://viacep.com.br/ws

# Mercado Pago PIX direto (default off até ligar no fluxo de venda)
PIX_DIRECT_ENABLED=false
MP_ACCESS_TOKEN=
# Alternativa ao MP_ACCESS_TOKEN (mesmo valor); um dos dois basta
MERCADOPAGO_ACCESS_TOKEN=
MP_BASE_URL=https://api.mercadopago.com
PIX_EXP_MIN=30
# URL pública do agent (Vercel), sem barra final — usada no notification_url do MP
PUBLIC_URL=https://ns-agent-for-sorteios.vercel.app

BREVO_API_KEY=
BREVO_WEBHOOK_SECRET=
BREVO_REPLY_MODE=auto
BREVO_AGENT_ID=
BREVO_AGENT_EMAIL=
BREVO_AGENT_NAME=NewStoreAgent
BREVO_RECEIVED_FROM=NewStoreAgent
BREVO_SENDER_NUMBER=
# Instagram temporarily disabled on Brevo — Meta ingress is the path forward.
BREVO_ALLOWED_CHANNELS=whatsapp,facebook
BREVO_SOCIAL_CHANNELS_ENABLED=true
AGENT_ASYNC_INGRESS_ENABLED=false
AGENT_INBOX_BATCH_SIZE=5

# Meta Instagram Messaging (FASE 3)
META_WEBHOOK_ENABLED=true
META_APP_SECRET=
# Instagram Login apps often have a separate Instagram app secret for webhook HMAC.
META_IG_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_IG_BUSINESS_ACCOUNT_ID=
INSTAGRAM_INGRESS_PROVIDER=meta
# Optional explicit map; if empty, META_IG_BUSINESS_ACCOUNT_ID → AGENT_PERSONA_TENANT_ID
# INSTAGRAM_STORY_* flags also listed in the Story section below.

DATABASE_URL=
# Sorteio/raffle domain DB (users, draw/draws, payments, app_config_new).
# Leave empty to fall back to DATABASE_URL (legacy shared database).
SORTEIO_DATABASE_URL=
AUTO_CREATE_TABLES=false
REMARKETING_ENABLED=false
REMARKETING_TOUCH_HOURS=1,12,23
REMARKETING_META_WINDOW_HOURS=24
REMARKETING_BATCH_SIZE=25
CRON_SECRET=

TRAY_ADAPTER_URL=
TRAY_ADAPTER_TOKEN=

ADMIN_API_TOKEN=

# --- Instagram Story ↔ product recognition ---
# With META_WEBHOOK_ENABLED=true and live media URL, Meta path can run even if
# these are false (meta_live_media bypass). For full Story pipeline set:
INSTAGRAM_STORY_RECOGNITION_ENABLED=true
INSTAGRAM_STORY_PAYLOAD_DIAGNOSTICS=false
INSTAGRAM_STORY_ROLLOUT_MODE=full
INSTAGRAM_STORY_CANARY_PERCENT=5
INSTAGRAM_STORY_REAL_PAYLOAD_VALIDATED=true
INSTAGRAM_STORY_VISION_MODEL=
INSTAGRAM_STORY_ANALYSIS_DETAIL=high
INSTAGRAM_STORY_ANALYSIS_VERSION=v2
INSTAGRAM_STORY_MEDIA_STORAGE_ENABLED=true
INSTAGRAM_STORY_MEDIA_MAX_BYTES=12582912
INSTAGRAM_STORY_MEDIA_TIMEOUT_SECONDS=10
INSTAGRAM_STORY_MEDIA_RETENTION_DAYS=7
INSTAGRAM_STORY_ALLOWED_HOSTS=
INSTAGRAM_STORY_STORAGE_BUCKET=
INSTAGRAM_STORY_ACCOUNT_TENANT_MAP=
INSTAGRAM_STORY_VIDEO_FRAME_ANALYSIS_ENABLED=false
INSTAGRAM_STORY_VIDEO_MAX_FRAMES=3
INSTAGRAM_STORY_VISUAL_CACHE_ENABLED=true
INSTAGRAM_STORY_VISUAL_CACHE_TTL_DAYS=30
INSTAGRAM_STORY_EXACT_MATCH_MIN_CONFIDENCE=0.95
INSTAGRAM_STORY_VISUAL_MATCH_MIN_CONFIDENCE=0.96
INSTAGRAM_STORY_AUTO_MATCH_MIN_CONFIDENCE=0.95
INSTAGRAM_STORY_AMBIGUOUS_MIN_CONFIDENCE=0.65
INSTAGRAM_STORY_MATCH_MARGIN=0.12
INSTAGRAM_STORY_MAX_CANDIDATES=10
INSTAGRAM_STORY_ADMIN_API_ENABLED=true

# --- Recommended rollout (do NOT force in production without soak) ---
# Step: canary_5 → canary_25 → canary_50 → canary_100 → full
# AGENT_ROLLOUT_PROFILE=canary_5
# Emergency one-shot: AGENT_EMERGENCY_ROLLBACK=true  (or PROFILE=emergency)
# OPENAI_API_MODE=canary
# OPENAI_RESPONSES_TRAFFIC_PERCENT=0.10
# AGENT_CONVERSATION_SUMMARY_ENABLED=true
# AGENT_FACTUAL_VALIDATION_MODE=enforce
# AGENT_QUALITY_JUDGE_MODE=off
# AGENT_CRITIQUE_MODE=shadow
# AGENT_CRITIQUE_LLM_ON_RISK_ONLY=true
# AGENT_MAX_LLM_CALLS_PER_TURN=3
